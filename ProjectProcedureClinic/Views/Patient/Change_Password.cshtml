@{
    ViewBag.Title = "Change_Password";
    Layout = "~/Views/Shared/PatientMaster.cshtml";
}
<div class="row">
<div class="col-4"></div>
<div class="col-4">
@using (Html.BeginForm("Change_Password", "Patient", FormMethod.Post))
{
    <label>Enter old password</label>
    <input type="password" class="form-control" name="oldpass" />

    <label>Enter new password</label>
    <input type="password" class="form-control" name="newpass" />

    <label>Enter confirm password</label>
    <input type="password" class="form-control" name="confirmpass" />

    <br />
    <input type="submit" class="form-control btn btn-success" value="Change Password" />
}
    </div>
<div class="col-4"></div>
    </div>


