@model IEnumerable<ProjectProcedureClinic.Models.Admin.ViewFeedback>

@{
    ViewBag.Title = "ViewFeedback";
    Layout = "~/Views/Shared/AdminMaster.cshtml";
}


<style>
    table td, table th {
        padding: 2px 4px;
    }
</style>

<div class="row">
    <div class="col-2"></div>
    <div class="col-10">

        <h4 class="text-center text-success">Feedback Reviews</h4>
        <hr class="text-danger" />

        <div class="table-responsive">
            <table cellspacing="0" cellpadding="0" class="table" id="example">
                <thead class="table-striped">
                    <tr style="background:orangered; color:white; ">
                        <th>ID</th>
                        <th>UserId</th>
                        <th>Rate</th>
                        <th>Message</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var data in Model)
                    {
                        <tr>
                            <td>@data.fid</td>
                            <td>@data.userid</td>
                            <td>@data.rate</td>
                            <td>@data.message</td>
                            <td>@data.fdate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
       
    </div>
</div>


<div id="feedbackList"></div>

