@model IEnumerable<ProjectProcedureClinic.Models.Admin.View_Doctor>
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/AdminMaster.cshtml";
}
<style>
    .topbar {
        margin-left: 250px;
        padding-left: 20px;
    }
    .card {
        max-width: 700px;
    }


</style>
<div class="main">

    <!-- Top Bar -->
    <div class="topbar d-flex align-items-center py-2 border-bottom">
       
        <div class="d-flex align-items-center gap-4 me-4">
            <i class="bi bi-bell fs-4"></i>
            <i class="bi bi-person-circle fs-3"></i>
        </div>

        <h4 class="text-info mb-0">Dashboard</h4>
    </div>

    <br />
    <br />

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-3">
            <div class="card shadow p-3 bg-info text-light">
                <h6>Total Doctors</h6>
                <h3>@ViewBag.Doctors</h3>
                <i class="bi bi-person-badge fs-1"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3 bg-danger text-light">
                <h6>Total Patients</h6>
                <h3>@ViewBag.Patients</h3>
                <i class="bi bi-people fs-1"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3 bg-success text-light">
                <h6>Appointments Today</h6>
                <h3>@ViewBag.TodayAppointments</h3>
                <i class="bi bi-calendar2-check fs-1"></i>
            </div>
        </div>

    </div>
    <br />
    <!-- Analytics -->
    <div class="row justify-content-center g-4">

        <!-- Patient Analytics -->
        <div class="col-md-4">
            <div class="card shadow p-3" style="height:400px;width:450px">
                <h6 class="mb-2 text-center">Patient Analytics</h6>
                <canvas id="patientChart"></canvas>
            </div>
        </div>

        <!-- Appointment Categories -->
        <div class="col-md-4">
            <div class="card shadow p-3" style="height:450px;width:450px">
                <h6 class="mb-2 text-center">Appointment Categories</h6>
                <canvas id="appointmentChart"></canvas>
            </div>
        </div>

    </div>



</div>
<br />
<style>
    table td, table th {
        padding: 2px 4px;
    }
</style>

<div class="row">
    <div class="col-2"></div>
    <div class="col-10" style="box-shadow:0px 0px 10px grey">

        <h2 class="text-center text-danger" style="padding-top: 80px;">View_Doctor</h2>
        <hr class="text-danger" />

        <div class="table-responsive">
            <table cellspacing="0" cellpadding="0" class="table" id="example">
                <thead class="table-striped bg-info>
                    <tr style="background:orangered; color:white; ">
                        <th>Name</th>
                        <th>Qualification</th>
                        <th>Specilist</th>
                       <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var data in Model)
                    {
                        <tr>
                            <td>@data.Name</td>
                            <td>@data.Qualification</td>
                            <td>@data.Specilist</td>
                            <td style="color:green">@ViewBag.Status</td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- REQUIRED SCRIPTS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // LINE CHART
    new Chart(document.getElementById('patientChart'), {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: 'Patients',
                data: [50, 70, 65, 90, 80, 120],
                borderColor: 'blue',
                borderWidth: 2,
                fill: false
            }]
        }
    });

    // PIE CHART
    new Chart(document.getElementById('appointmentChart'), {
        type: 'pie',
        data: {
            labels: ['Cardiology', 'Dermatology', 'Ortho', 'Neuro'],
            datasets: [{
                data: [35, 25, 20, 20],
                backgroundColor: ['#ff6384', '#36a2eb', '#ffcd56', '#4bc0c0']
            }]
        }
    });
</script>
