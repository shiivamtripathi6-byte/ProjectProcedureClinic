@{
    ViewBag.Title = "Service";
    Layout = "~/Views/Shared/GeneralMaster.cshtml";
}
<link href="~/Content/Services.css" rel="stylesheet" />

        <!-- Hero Section -->
        <div class="hero">
            <div class="hero-text">
                <h1>Our Services</h1>
                <p>Professional • Reliable • Patient-Centered</p>
            </div>
        </div>

        <!-- Services Section -->
        <div class="container">
            <h2 class="section-title">What We Offer</h2>

            <div class="services-grid">

                <div class="service-box">
                    <div class="service-icon">🏥</div>
                    <h3>24/7 Emergency Care</h3>
                    <p>Round‑the‑clock emergency services with advanced life‑saving equipment and expert doctors.</p>
                </div>

                <div class="service-box">
                    <div class="service-icon">🩺</div>
                    <h3>General Checkup</h3>
                    <p>Comprehensive health checkups with accurate diagnosis and preventive care.</p>
                </div>

                <div class="service-box">
                    <div class="service-icon">🧪</div>
                    <h3>Diagnostic Laboratory</h3>
                    <p>Modern lab tests with fast, reliable, and precise reports by certified professionals.</p>
                </div>

                <div class="service-box">
                    <div class="service-icon">🧑‍⚕️</div>
                    <h3>Specialist Doctors</h3>
                    <p>Expert doctors in cardiology, neurology, orthopedics, pediatrics, and more.</p>
                </div>

                <div class="service-box">
                    <div class="service-icon">💊</div>
                    <h3>Pharmacy</h3>
                    <p>24/7 pharmacy providing genuine medicines at affordable prices.</p>
                </div>

                <div class="service-box">
                    <div class="service-icon">🛏️</div>
                    <h3>In‑Patient Rooms</h3>
                    <p>Comfortable and hygienic patient rooms with nursing assistance.</p>
                </div>

            </div>
        </div>

