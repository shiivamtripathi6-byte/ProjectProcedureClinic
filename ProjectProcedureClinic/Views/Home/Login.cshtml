@model ProjectProcedureClinic.Models.Home.Login
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/GeneralMaster.cshtml";
    }
<style>
    body {
        background: url('/Content/images/image1.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-radius: 15px;
        padding: 5%;
        margin-top: 2%;
        box-shadow: 0px 0px 10px 0px grey;
    }
</style>
    <div class="row">
    <div class="col-4"></div>
    <div class="col-4 login-box">
        <h1 class="text text-success" style="font-family: 'Monotype Corsiva'; font-weight:bolder"><span class="fa fa-key"></span>Login Panel Here</h1>
        <hr style="background:maroon; height:3px" />
        @using (Html.BeginForm("Login", "Home", FormMethod.Post))
        {
            @Html.LabelFor(model => model.UserId)
            @Html.TextBoxFor(model => model.UserId, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.UserId, "", new { style = "color:red" })


            @Html.LabelFor(model => model.Password)
            @Html.TextBoxFor(model => model.Password, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.Password, "", new { style = "color:red" })
            <div class="row">
                <div class="col-4" style="margin-top:8%">
                    <h2 id="cph">@ViewBag.cph</h2>
                    <input type="hidden" name="txtcaptcha" value="@ViewBag.cph" />
                </div>
                <div class="col-2" style="margin-top:3%; font-size:40px; color:green">
                    <span class="fa fa-refresh btn-lg btn-info" style="font-size:40px"></span>
                </div>
                <div class="col-6">
                    Captcha Code Here
                    <input type="text" name="txtcaptchacode" class="form-control" />
                </div>
            </div>
            <br />
            <button class="btn btn-primary form-floating form-control form-control-lg">
                <span class="fa fa-sign-in text-light"></span>
                Sign In
            </button>
            <br />
            <h3>@ViewBag.msg</h3>
        }
    </div>
    <script>
        $(document).ready(function () {
            $("#cph,input[name='txtcaptchacode']").on("cut copy paste", function (e) {
                e.preventDefault();
            })
            $(".fa-refresh").click(function () {
                $.ajax({
                    type: "Post",
                    url: "/Home/RefreshCaptcha",
                    success: function (data) {
                        $("#cph").text(data);
                        $("input[name='txtcaptcha']").val(data);
                    }
                })
            })
        })
    </script>

</div>
