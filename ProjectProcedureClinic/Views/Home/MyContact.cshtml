@model ProjectProcedureClinic.Models.Home.MyContact
@{
    ViewBag.Title = "MyContact";
    Layout = "~/Views/Shared/GeneralMaster.cshtml";
}
<style>
    body {
        background: url('/Content/images/image1.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .contact-box {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-radius: 15px;
        padding: 5%;
        margin-top: 2%;
        box-shadow: 0px 0px 10px 0px grey;
    }
</style>
<div class="row">
    <div class="col-4"></div>
    <div class="col-4 contact-box">
        <h1 class="text text-success" style="font-family: 'Monotype Corsiva'; font-weight:bolder"><span class="fa fa-phone"></span>Contact Panel Here</h1>
        <hr style="background:maroon; height:3px" />
        @using (Html.BeginForm("MyContact", "Home", FormMethod.Post))
        {
            @Html.LabelFor(model => model.Name)
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.Name, "", new { style = "color:red" })


            @Html.LabelFor(model => model.Email)
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.Email, "", new { style = "color:red" })

            @Html.LabelFor(model => model.Mobile)
            @Html.TextBoxFor(model => model.Mobile, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.Mobile, "", new { style = "color:red" })

            @Html.LabelFor(model => model.Message)
            @Html.TextBoxFor(model => model.Message, new { @class = "form-control-lg form-control" })
            @Html.ValidationMessageFor(model => model.Message, "", new { style = "color:red" })
            <br />

            <input type="submit" value="Submit" class="btn btn-success form-control" />
        }
    </div>
        <div class="col-4"></div>    
  </div>
<h3>@ViewBag.show</h3>