<!-- Services Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center text-primary mb-4">Our Hospital Services</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/Content/images/cardiolo.jpeg" class="card-img-top" alt="Cardiology Service">
                    <div class="card-body">
                        <h5 class="card-title">Cardiology</h5>
                        <p class="card-text">Advanced heart care services including ECG, Echo, angiography, and full cardiac checkups.</p>
                        <a href="~/Home/AboutUs" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/Content/images/nero.jpeg" class="card-img-top" alt="Neurology Service">
                    <div class="card-body">
                        <h5 class="card-title">Neurology</h5>
                        <p class="card-text">Stroke treatment, EEG, nerve testing, and expert consultation for all neurological disorders.</p>
                        <a href="~/Home/AboutUs" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/Content/images/emergency.jpeg" class="card-img-top" alt="Emergency Care">
                    <div class="card-body">
                        <h5 class="card-title">24/7 Emergency Care</h5>
                        <p class="card-text">Fully equipped emergency unit with life‑saving facilities and dedicated doctors available round the clock.</p>
                        <a href="~/Home/AboutUs" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Departments Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4 text-primary">Hospital Departments</h2>
        <p class="text-center text-muted mb-5">We provide world-class medical services</p>
        <div class="row g-4">
            @* Example Department Card *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 text-center p-3 shadow-sm">
                    <i class="fa-solid fa-heart-pulse fa-2x mb-3 text-primary"></i>
                    <div class="card-body">
                        <h5 class="card-title">Cardiology</h5>
                        <p class="card-text">Advanced heart care, diagnosis and treatment by expert cardiologists.</p>
                        <a href="/Home/AboutUs" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 text-center p-3 shadow-sm">
                    <i class="fa-solid fa-brain fa-2x mb-3 text-primary"></i>
                    <div class="card-body">
                        <h5 class="card-title">Neurology</h5>
                        <p class="card-text">Complete care for brain, spine and nervous system disorders.</p>
                        <a href="/Home/AboutUs" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 text-center p-3 shadow-sm">
                    <i class="fa-solid fa-user-doctor fa-2x mb-3 text-primary"></i>
                    <div class="card-body">
                        <h5 class="card-title">Orthopedics</h5>
                        <p class="card-text">Bone, joint and muscle treatment with modern techniques.</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">Read More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Doctors Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-4 text-primary">Doctors</h2>
        <div class="row justify-content-center g-4">
            @foreach (var data in Model)
            {
                <div class="col-md-3 text-center bg-white p-4 rounded shadow-sm">
                    <img src="~/Content/images/DoctorsPic/@data.fupic" class="img-fluid rounded-circle mb-3" style="height:120px; width:120px;">
                    <h5>@data.Name</h5>
                    <p><strong>Specialist:</strong> @data.Specilist</p>
                    <p><strong>Fees:</strong> @data.Amount</p>
                    <p><strong>Timing:</strong> @data.Time</p>
                    <a href="~/Home/AddPatient" class="btn btn-primary btn-sm">Appointment</a>
                </div>
            }
        </div>
    </div>
</section>
